{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static",
      "config": "vite.config.js"
    }
  ],
  "routes": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    }
  ],
  "env": {
    "MONGO_URI": "@mongo-db",
    "JWT_SECRET": "@jwt-secret"
  }
}
